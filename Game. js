// ==========================================
// GAMEHUB 3D GAME ENGINE
// ==========================================

// Three.js
const THREE = window.THREE;

// ------------------------------------------
// GAME SETTINGS
// ------------------------------------------

const GAME = {
    running: false,
    sensitivity: 0.003,
    gravity: 28,
    walkSpeed: 7,
    sprintSpeed: 11,
    jumpPower: 11
};

// ------------------------------------------
// PLAYER
// ------------------------------------------

const player = {
    health: 100,
    shield: 100,

    position: new THREE.Vector3(0, 2, 10),

    velocity: new THREE.Vector3(),

    rotation: {
        x: 0,
        y: 0
    },

    grounded: true,

    buildMode: false,

    selectedBuild: "wall",

    weapon: "Rifle",

    ammo: 30
};

// ------------------------------------------
// THREE.JS VARIABLES
// ------------------------------------------

let scene;
let camera;
let renderer;

let playerObject;

let clock;

let keys = {};

let bullets = [];

let builds = [];

let otherPlayers = {};


// ------------------------------------------
// START GAME
// ------------------------------------------

function start3DGame() {

    const canvas = document.getElementById("gameCanvas");

    if (!canvas) {
        console.error("Game canvas not found.");
        return;
    }

    GAME.running = true;

    // Scene
    scene = new THREE.Scene();

    scene.background = new THREE.Color(0x87ceeb);

    // Camera
    camera = new THREE.PerspectiveCamera(
        75,
        window.innerWidth / window.innerHeight,
        0.1,
        3000
    );

    camera.position.set(
        player.position.x,
        player.position.y + 1.7,
        player.position.z
    );

    // Renderer
    renderer = new THREE.WebGLRenderer({
        canvas: canvas,
        antialias: true
    });

    renderer.setPixelRatio(
        Math.min(window.devicePixelRatio, 2)
    );

    renderer.setSize(
        window.innerWidth,
        window.innerHeight - 70
    );

    renderer.shadowMap.enabled = true;

    // Clock
    clock = new THREE.Clock();

    createLighting();

    createWorld();

    createPlayer();

    createWeapons();

    setupControls();

    window.addEventListener(
        "resize",
        resizeGame
    );

    animate();

}


// ------------------------------------------
// LIGHTING
// ------------------------------------------

function createLighting() {

    const sunlight =
        new THREE.DirectionalLight(
            0xffffff,
            2
        );

    sunlight.position.set(
        200,
        300,
        100
    );

    sunlight.castShadow = true;

    sunlight.shadow.mapSize.width = 2048;
    sunlight.shadow.mapSize.height = 2048;

    scene.add(sunlight);


    const ambient =
        new THREE.HemisphereLight(
            0xbfe8ff,
            0x304020,
            1.5
        );

    scene.add(ambient);

}


// ------------------------------------------
// WORLD
// ------------------------------------------

function createWorld() {

    // Ground
    const groundGeometry =
        new THREE.PlaneGeometry(
            3000,
            3000
        );

    const groundMaterial =
        new THREE.MeshStandardMaterial({
            color: 0x4d8b45
        });

    const ground =
        new THREE.Mesh(
            groundGeometry,
            groundMaterial
        );

    ground.rotation.x =
        -Math.PI / 2;

    ground.receiveShadow = true;

    scene.add(ground);


    // Trees
    for (let i = 0; i < 100; i++) {

        const x =
            (Math.random() - 0.5) * 1800;

        const z =
            (Math.random() - 0.5) * 1800;

        createTree(x, z);

    }


    // Buildings
    for (let i = 0; i < 20; i++) {

        const x =
            (Math.random() - 0.5) * 1500;

        const z =
            (Math.random() - 0.5) * 1500;

        createBuilding(x, z);

    }

}


// ------------------------------------------
// TREES
// ------------------------------------------

function createTree(x, z) {

    const tree =
        new THREE.Group();


    const trunk =
        new THREE.Mesh(

            new THREE.CylinderGeometry(
                1,
                1.4,
                8,
                8
            ),

            new THREE.MeshStandardMaterial({
                color: 0x6b4423
            })

        );

    trunk.position.y = 4;

    trunk.castShadow = true;

    tree.add(trunk);


    const leaves =
        new THREE.Mesh(

            new THREE.SphereGeometry(
                5,
                12,
                12
            ),

            new THREE.MeshStandardMaterial({
                color: 0x27753a
            })

        );

    leaves.position.y = 10;

    leaves.castShadow = true;

    tree.add(leaves);


    tree.position.set(
        x,
        0,
        z
    );

    scene.add(tree);

}


// ------------------------------------------
// BUILDINGS
// ------------------------------------------

function createBuilding(x, z) {

    const width =
        30 + Math.random() * 40;

    const height =
        15 + Math.random() * 40;

    const depth =
        30 + Math.random() * 40;


    const geometry =
        new THREE.BoxGeometry(
            width,
            height,
            depth
        );

    const material =
        new THREE.MeshStandardMaterial({
            color: 0x68717c
        });

    const building =
        new THREE.Mesh(
            geometry,
            material
        );

    building.position.set(
        x,
        height / 2,
        z
    );

    building.castShadow = true;

    building.receiveShadow = true;

    scene.add(building);

}


// ------------------------------------------
// PLAYER
// ------------------------------------------

function createPlayer() {

    playerObject =
        new THREE.Group();


    // Body
    const body =
        new THREE.Mesh(

            new THREE.BoxGeometry(
                1.3,
                2,
                0.8
            ),

            new THREE.MeshStandardMaterial({
                color: 0x5865f2
            })

        );

    body.position.y = 1.8;

    body.castShadow = true;

    playerObject.add(body);


    // Head
    const head =
        new THREE.Mesh(

            new THREE.SphereGeometry(
                0.55,
                20,
                20
            ),

            new THREE.MeshStandardMaterial({
                color: 0xd8a06d
            })

        );

    head.position.y = 3.2;

    head.castShadow = true;

    playerObject.add(head);


    // Legs
    const legMaterial =
        new THREE.MeshStandardMaterial({
            color: 0x202a3c
        });


    const leftLeg =
        new THREE.Mesh(
            new THREE.BoxGeometry(
                0.45,
                1.5,
                0.5
            ),
            legMaterial
        );

    leftLeg.position.set(
        -0.35,
        0.75,
        0
    );

    playerObject.add(leftLeg);


    const rightLeg =
        new THREE.Mesh(
            new THREE.BoxGeometry(
                0.45,
                1.5,
                0.5
            ),
            legMaterial
        );

    rightLeg.position.set(
        0.35,
        0.75,
        0
    );

    playerObject.add(rightLeg);


    playerObject.position.copy(
        player.position
    );

    scene.add(playerObject);

}


// ------------------------------------------
// WEAPON
// ------------------------------------------

function createWeapons() {

    const weapon =
        new THREE.Mesh(

            new THREE.BoxGeometry(
                0.25,
                0.25,
                2.2
            ),

            new THREE.MeshStandardMaterial({
                color: 0x202020
            })

        );

    weapon.position.set(
        0.8,
        2.1,
        -1
    );

    playerObject.add(weapon);

}


// ------------------------------------------
// CONTROLS
// ------------------------------------------

function setupControls() {

    document.addEventListener(
        "keydown",
        function(event) {

            keys[event.code] = true;


            // Build mode
            if (event.code === "KeyQ") {

                player.buildMode =
                    !player.buildMode;

                console.log(
                    "Build mode:",
                    player.buildMode
                );

            }


            // Building selection
            if (event.code === "Digit1") {

                player.selectedBuild =
                    "wall";

            }

            if (event.code === "Digit2") {

                player.selectedBuild =
                    "floor";

            }

            if (event.code === "Digit3") {

                player.selectedBuild =
                    "ramp";

            }


            // Jump
            if (
                event.code === "Space" &&
                player.grounded
            ) {

                player.velocity.y =
                    GAME.jumpPower;

                player.grounded = false;

            }

        }
    );


    document.addEventListener(
        "keyup",
        function(event) {

            keys[event.code] = false;

        }
    );


    document.addEventListener(
        "mousedown",
        function(event) {

            if (!GAME.running)
                return;


            if (player.buildMode) {

                build();

            } else {

                shoot();

            }

        }
    );


    // Mouse look
    document.addEventListener(
        "mousemove",
        function(event) {

            if (
                document.pointerLockElement
                !== renderer.domElement
            )
                return;


            player.rotation.y -=
                event.movementX *
                GAME.sensitivity;

            player.rotation.x -=
                event.movementY *
                GAME.sensitivity;


            player.rotation.x =
                Math.max(
                    -1.4,
                    Math.min(
                        1.4,
                        player.rotation.x
                    )
                );

        }
    );


    renderer.domElement.addEventListener(
        "click",
        function() {

            renderer.domElement
                .requestPointerLock();

        }
    );

}


// ------------------------------------------
// PLAYER MOVEMENT
// ------------------------------------------

function updatePlayer(delta) {

    const speed =
        keys["ShiftLeft"] ||
        keys["ShiftRight"]
            ? GAME.sprintSpeed
            : GAME.walkSpeed;


    const direction =
        new THREE.Vector3();


    if (keys["KeyW"])
        direction.z -= 1;

    if (keys["KeyS"])
        direction.z += 1;

    if (keys["KeyA"])
        direction.x -= 1;

    if (keys["KeyD"])
        direction.x += 1;


    if (direction.length() > 0) {

        direction.normalize();

        direction.applyAxisAngle(
            new THREE.Vector3(0,1,0),
            player.rotation.y
        );

        player.velocity.x =
            direction.x * speed;

        player.velocity.z =
            direction.z * speed;

    } else {

        player.velocity.x *= 0.8;

        player.velocity.z *= 0.8;

    }


    // Gravity
    player.velocity.y -=
        GAME.gravity * delta;


    player.position.x +=
        player.velocity.x * delta;

    player.position.y +=
        player.velocity.y * delta;

    player.position.z +=
        player.velocity.z * delta;


    // Ground
    if (player.position.y <= 2) {

        player.position.y = 2;

        player.velocity.y = 0;

        player.grounded = true;

    }


    playerObject.position.copy(
        player.position
    );


    playerObject.rotation.y =
        player.rotation.y;


    // Camera
    camera.position.set(
        player.position.x,
        player.position.y + 1.6,
        player.position.z
    );


    camera.rotation.order =
        "YXZ";

    camera.rotation.y =
        player.rotation.y;

    camera.rotation.x =
        player.rotation.x;

}


// ------------------------------------------
// BUILDING
// ------------------------------------------

function build() {

    const distance = 8;


    const direction =
        new THREE.Vector3(
            0,
            0,
            -1
        );


    direction.applyQuaternion(
        camera.quaternion
    );


    const position =
        player.position.clone();


    position.add(
        direction.multiplyScalar(distance)
    );


    position.x =
        Math.round(position.x / 4) * 4;

    position.y =
        Math.round(position.y / 4) * 4;

    position.z =
        Math.round(position.z / 4) * 4;


    let object;


    if (player.selectedBuild === "wall") {

        object =
            createWall(position);

    }


    if (player.selectedBuild === "floor") {

        object =
            createFloor(position);

    }


    if (player.selectedBuild === "ramp") {

        object =
            createRamp(position);

    }


    if (object) {

        builds.push(object);

        scene.add(object);

    }

}


// ------------------------------------------
// WALL
// ------------------------------------------

function createWall(position) {

    const geometry =
        new THREE.BoxGeometry(
            4,
            4,
            0.25
        );


    const material =
        new THREE.MeshStandardMaterial({
            color: 0x69b9d6,
            transparent: true,
            opacity: 0.85
        });


    const wall =
        new THREE.Mesh(
            geometry,
            material
        );


    wall.position.copy(
        position
    );


    return wall;

}


// ------------------------------------------
// FLOOR
// ------------------------------------------

function createFloor(position) {

    const geometry =
        new THREE.BoxGeometry(
            4,
            0.25,
            4
        );


    const material =
        new THREE.MeshStandardMaterial({
            color: 0x69b9d6,
            transparent: true,
            opacity: 0.85
        });


    const floor =
        new THREE.Mesh(
            geometry,
            material
        );


    floor.position.copy(
        position
    );


    return floor;

}


// ------------------------------------------
// RAMP
// ------------------------------------------

function createRamp(position) {

    const geometry =
        new THREE.BoxGeometry(
            4,
            0.25,
            5
        );


    const material =
        new THREE.MeshStandardMaterial({
            color: 0x69b9d6,
            transparent: true,
            opacity: 0.85
        });


    const ramp =
        new THREE.Mesh(
            geometry,
            material
        );


    ramp.position.copy(
        position
    );


    ramp.rotation.x =
        -Math.PI / 6;


    return ramp;

}


// ------------------------------------------
// SHOOTING
// ------------------------------------------

function shoot() {

    if (player.ammo <= 0) {

        player.ammo = 30;

        return;

    }


    player.ammo--;


    const geometry =
        new THREE.SphereGeometry(
            0.08,
            8,
            8
        );


    const material =
        new THREE.MeshBasicMaterial({
            color: 0xffff00
        });


    const bullet =
        new THREE.Mesh(
            geometry,
            material
        );


    bullet.position.copy(
        camera.position
    );


    const direction =
        new THREE.Vector3(
            0,
            0,
            -1
        );


    direction.applyQuaternion(
        camera.quaternion
    );


    bullet.userData.velocity =
        direction.multiplyScalar(100);


    bullet.userData.life = 3;


    scene.add(bullet);

    bullets.push(bullet);

}


// ------------------------------------------
// BULLET UPDATE
// ------------------------------------------

function updateBullets(delta) {

    for (
        let i = bullets.length - 1;
        i >= 0;
        i--
    ) {

        const bullet =
            bullets[i];


        bullet.position.x +=
            bullet.userData.velocity.x *
            delta;

        bullet.position.y +=
            bullet.userData.velocity.y *
            delta;

        bullet.position.z +=
            bullet.userData.velocity.z *
            delta;


        bullet.userData.life -=
            delta;


        if (
            bullet.userData.life <= 0
        ) {

            scene.remove(bullet);

            bullets.splice(i,1);

        }

    }

}


// ------------------------------------------
// HEALTH
// ------------------------------------------

function damagePlayer(amount) {

    if (player.shield > 0) {

        const shieldDamage =
            Math.min(
                player.shield,
                amount
            );

        player.shield -=
            shieldDamage;

        amount -=
            shieldDamage;

    }


    if (amount > 0) {

        player.health -=
            amount;

    }


    if (player.health <= 0) {

        player.health = 0;

        eliminatePlayer();

    }


    updateHUD();

}


// ------------------------------------------
// ELIMINATION
// ------------------------------------------

function eliminatePlayer() {

    GAME.running = false;

    alert(
        "You were eliminated!"
    );

}


// ------------------------------------------
// HUD
// ------------------------------------------

function updateHUD() {

    const hp =
        document.getElementById("hp");

    const shield =
        document.getElementById("shield");


    if (hp) {

        hp.style.width =
            player.health + "%";

    }


    if (shield) {

        shield.style.width =
            player.shield + "%";

    }

}


// ------------------------------------------
// RESIZE
// ------------------------------------------

function resizeGame() {

    if (!camera || !renderer)
        return;


    camera.aspect =
        window.innerWidth /
        (window.innerHeight - 70);


    camera.updateProjectionMatrix();


    renderer.setSize(
        window.innerWidth,
        window.innerHeight - 70
    );

}


// ------------------------------------------
// MAIN LOOP
// ------------------------------------------

function animate() {

    if (!GAME.running)
        return;


    requestAnimationFrame(
        animate
    );


    const delta =
        Math.min(
            clock.getDelta(),
            0.05
        );


    updatePlayer(delta);

    updateBullets(delta);

    updateHUD();


    renderer.render(
        scene,
        camera
    );

}


